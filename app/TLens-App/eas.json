{
  "cli": {
    "version": ">= 12.5.1",
    "appVersionSource": "remote" 
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true, 
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.jvmargs=-Xmx3g -Dorg.gradle.daemon=false -XX:MaxMetaspaceSize=512m"
      }
    }
  },
  "submit": {
    "production": {}
  }
}